{
  "name": "cozy-studio",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first studio to generate and manage images through ChatGPT HTTP, Codex app-server, and other providers.",
  "keywords": [
    "bun",
    "chatgpt",
    "codex",
    "hono",
    "image-generation",
    "local-first",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "mcp": "bun run scripts/studio-mcp.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:ui": "vp dev",
    "dev:server": "bun apps/local-server/src/index.ts",
    "studio:init": "bun run scripts/studio-init.ts",
    "studio:onboard": "bun run scripts/studio-onboard.ts",
    "assets:responsive": "bun run scripts/build-responsive-ui-images.ts",
    "assets:responsive:check": "bun run scripts/build-responsive-ui-images.ts --check",
    "assets:character-lab:icons": "bun run scripts/build-character-lab-icon-assets.ts",
    "assets:character-lab:option-icons": "bun run scripts/build-character-lab-option-icon-assets.ts",
    "styles:browser": "tsx ./scripts/verify-styles-browser-gate.ts",
    "styles:browser:verify": "tsx ./scripts/verify-styles-browser-gate.ts --verify",
    "recipes:catalog": "bun run scripts/query-recipe-modules.ts",
    "recipes:examples:verify": "bun run scripts/validate-recipe-module-examples.ts",
    "recipes:verify": "bun run scripts/query-recipe-modules.ts --verify && bun run recipes:examples:verify && bun run recipes:evaluate -- --verify",
    "recipes:evaluate": "bun run scripts/evaluate-recipe-prompts.ts",
    "recipes:evaluate:live": "bun run scripts/evaluate-recipe-prompts-live.ts",
    "providers:audit": "bun run scripts/audit-provider-inputs.ts",
    "providers:verify": "bun run providers:audit -- --verify",
    "providers:preflight": "bun run scripts/query-provider-runtime.ts",
    "runtime:doctor": "bun run scripts/query-codex-runtime.ts",
    "portability:smoke": "bun run scripts/portability-smoke.ts",
    "isolation:verify": "bunx vitest run contexts/GenerationIsolation.runtime.test.tsx contexts/RuntimeLogIsolation.runtime.test.tsx contexts/RuntimeLogContext.subscription.test.ts hooks/useStudioShell.composition.test.ts hooks/useGenerationQueueController.test.tsx hooks/useCatalogModalDetailHydration.test.tsx hooks/useStudioReset.test.ts",
    "storage:audit": "bun run scripts/studio-storage-maintenance.ts audit",
    "storage:compact": "bun run scripts/studio-storage-maintenance.ts compact",
    "storage:thumbnails:backfill": "bun run scripts/studio-storage-maintenance.ts thumbnails:backfill",
    "ui:chunks": "bun run scripts/report-ui-chunks.ts",
    "ui:chunks:verify": "bun run scripts/report-ui-chunks.ts --verify",
    "architecture:source:verify": "bun run scripts/architecture-source-rules.ts",
    "architecture:verify": "bun run lint && bun run architecture:source:verify && bun run isolation:verify",
    "ui:responsive": "tsx ./scripts/verify-responsive-mobile.ts",
    "ui:responsive:verify": "tsx ./scripts/verify-responsive-mobile.ts --verify",
    "styles:render": "bun run scripts/report-style-render-budget.ts",
    "styles:render:verify": "bun run scripts/report-style-render-budget.ts --verify",
    "fmt": "bun run scripts/tooling-task.ts fmt",
    "fmt:check": "bun run scripts/tooling-task.ts fmt:check",
    "lint": "bun run scripts/tooling-task.ts lint",
    "lint:fix": "bun run scripts/tooling-task.ts lint:fix",
    "check": "bun run scripts/tooling-task.ts check",
    "check:fix": "bun run scripts/tooling-task.ts check:fix",
    "typecheck:web": "bunx tsc --noEmit --pretty false -p tsconfig.web.json",
    "typecheck:shared": "bunx tsc --noEmit --pretty false -p packages/shared/tsconfig.json",
    "typecheck:scripts": "bunx tsc --noEmit --pretty false -p tsconfig.scripts.json && bunx tsc --noEmit --pretty false -p tsconfig.browser-scripts.json",
    "typecheck:environments": "bun run typecheck:web && bun run build:server && bun run typecheck:shared && bun run typecheck:scripts",
    "test": "bun run scripts/tooling-task.ts test",
    "test:unit": "bun run scripts/tooling-task.ts test:unit",
    "test:bun": "bun run scripts/tooling-task.ts test:bun",
    "test:coverage": "bun run scripts/tooling-task.ts test:coverage",
    "build": "bun run scripts/tooling-task.ts build",
    "build:ui": "bun run scripts/tooling-task.ts build:ui",
    "build:server": "bun run scripts/tooling-task.ts build:server",
    "validate:fast": "bun run scripts/tooling-task.ts validate:fast",
    "validate": "bun run scripts/tooling-task.ts validate",
    "validate:full": "bun run scripts/tooling-task.ts validate:full",
    "validate:release": "bun run scripts/tooling-task.ts validate:release",
    "docs:check": "bun run scripts/check-docs.ts",
    "repo:hygiene:verify": "bun run scripts/audit-repo-hygiene.ts --verify",
    "repo:assets:audit": "bun run scripts/audit-repo-assets.ts --verify",
    "repo:assets:lock": "bun run scripts/audit-repo-assets.ts --update-lock",
    "core-assets:smoke": "bun run scripts/core-assets-smoke.ts",
    "preview": "vp preview",
    "tooling:logs": "bun run scripts/open-tooling-logs.ts",
    "tooling:logs:prune": "bun run scripts/tooling-task.ts tooling:logs:prune",
    "start": "bun run scripts/portable-start.ts",
    "portable:build": "bun run scripts/build-portable.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@fal-ai/client": "^1.10.1",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "clsx": "^2.1.1",
    "effect": "4.1.2",
    "gsap": "^3.15.0",
    "hono": "^4.13.16",
    "iconoir-react": "^7.12.1",
    "jszip": "^3.10.2",
    "nuqs": "2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}

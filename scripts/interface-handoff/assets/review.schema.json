{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interface Handoff Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "summary", "preserve", "limitations", "findings"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "kind",
          "origin",
          "certainty",
          "view_id",
          "state_id",
          "evidence",
          "problem",
          "impact",
          "proposal",
          "acceptance",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "kind": {
            "enum": [
              "usability",
              "visual",
              "accessibility",
              "consistency",
              "content",
              "functional",
              "preference",
              "evidence-limit"
            ]
          },
          "origin": {
            "enum": ["product", "export", "unknown"]
          },
          "certainty": {
            "enum": ["observed", "inferred", "needs-validation"]
          },
          "view_id": {
            "type": ["string", "null"]
          },
          "state_id": {
            "type": ["string", "null"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

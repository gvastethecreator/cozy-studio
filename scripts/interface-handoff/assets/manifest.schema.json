{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interface Handoff Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "created_at",
    "project",
    "entrypoint",
    "portability",
    "scope",
    "views",
    "checks",
    "artifacts",
    "files",
    "delivery"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision",
        "working_tree",
        "source_fingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "working_tree": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        },
        "source_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "verified",
        "notes"
      ],
      "properties": {
        "target": {
          "enum": [
            "file",
            "localhost",
            "evidence-only"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "included",
        "excluded"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "full",
            "partial"
          ]
        },
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source_refs",
          "states"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "entry",
                "render",
                "behavior",
                "test",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "entry": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "render": {
                  "enum": [
                    "original-components",
                    "original-static",
                    "approximation",
                    "unavailable"
                  ]
                },
                "behavior": {
                  "enum": [
                    "original-local",
                    "simulated",
                    "mixed",
                    "unavailable"
                  ]
                },
                "test": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "failed",
                    "not_run",
                    "not_applicable"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portability",
        "fidelity",
        "interactions",
        "privacy"
      ],
      "properties": {
        "portability": {
          "type": "object",
          "required": [
            "status",
            "evidence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "fidelity": {
          "type": "object",
          "required": [
            "status",
            "evidence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "interactions": {
          "type": "object",
          "required": [
            "status",
            "evidence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "privacy": {
          "type": "object",
          "required": [
            "status",
            "evidence",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_here",
        "review_prompt",
        "product",
        "design_system",
        "coverage",
        "source_map",
        "limitations",
        "qa"
      ],
      "properties": {
        "start_here": {
          "type": "string",
          "minLength": 1
        },
        "review_prompt": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "design_system": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "source_map": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "qa": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "generator_version",
        "profile",
        "agent_ready",
        "agent_entrypoint",
        "brief",
        "file_index",
        "review_plan",
        "review_schema",
        "review_contract",
        "human_entrypoint",
        "content_fingerprint"
      ],
      "properties": {
        "format": {
          "const": "interface-handoff-delivery/1.0"
        },
        "generator_version": {
          "const": "0.4.0"
        },
        "profile": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "agent_ready": {
          "const": true
        },
        "agent_entrypoint": {
          "const": "AGENTS.md"
        },
        "brief": {
          "const": "agent/brief.json"
        },
        "file_index": {
          "const": "agent/file-index.json"
        },
        "review_plan": {
          "const": "agent/review-plan.json"
        },
        "review_schema": {
          "const": "agent/review.schema.json"
        },
        "review_contract": {
          "const": "agent/review-contract.md"
        },
        "human_entrypoint": {
          "enum": [
            null,
            "LEEME.html"
          ]
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "human"
              }
            }
          },
          "then": {
            "properties": {
              "human_entrypoint": {
                "const": "LEEME.html"
              }
            }
          },
          "else": {
            "properties": {
              "human_entrypoint": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}

{
  "name": "cozy-studio-landing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build-astro.mjs site.yaml dist /cozy-studio/",
    "build:local": "node scripts/build-astro.mjs site.yaml dist-local /",
    "build:cloudflare": "node scripts/build-astro.mjs site.yaml dist-astro /",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "@vgpu/wgsl": "0.6.0",
    "astro": "^7.4.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "vgpu": "0.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}

#!/bin/sh

# Documentation and generated maps do not need a staged React scan.
if git diff --cached --quiet --diff-filter=ACMR -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' '*.html' \
  ':!docs/codemap/**'; then
  exit 0
fi

if ! command -v bun >/dev/null 2>&1; then
  printf '%s\n' 'React Doctor scan skipped: Bun is not available. Run bun run doctor -- --staged when Bun is available.' >&2
  exit 0
fi

react_doctor_log='logs/react-doctor/pre-commit.log'
if ! mkdir -p 'logs/react-doctor'; then
  printf '%s\n' 'React Doctor scan skipped: could not create logs/react-doctor.' >&2
  exit 0
fi

if bun run doctor -- --staged --blocking warning --no-score > "$react_doctor_log" 2>&1; then
  exit 0
else
  react_doctor_status=$?
  printf '%s\n' \
    "React Doctor staged check did not pass (exit $react_doctor_status)." \
    "Review $react_doctor_log for diagnostics or execution errors." \
    'This hook is advisory; the commit can continue.' >&2
fi

exit 0

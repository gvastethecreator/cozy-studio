{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶️ Dev",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "🧪 Test",
      "type": "shell",
      "command": "bun run test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "🧹 Check",
      "type": "shell",
      "command": "bun run check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "🏗️ Build",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🔌 Provider status",
      "type": "shell",
      "command": "bun run providers:preflight",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "🩺 Runtime",
      "type": "shell",
      "command": "bun run runtime:doctor",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "🎨 Styles",
      "type": "shell",
      "command": "bun run styles:verify",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "🧾 Docs",
      "type": "shell",
      "command": "bun run docs:check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "📜 Logs",
      "type": "shell",
      "command": "bun run tooling:logs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}

# Copy this file to `.env.local` if you want to customize the studio manually.
# You can also run `bun run studio:init`: if `.env.local` does not exist, the script creates it automatically.
#
# Studio Library path (SQLite, settings, thumbnails, logs). Leave unset to use the
# private app-data folder:
#   Windows: %LOCALAPPDATA%\Cozy Studio\Library
#   macOS:   ~/Library/Application Support/Cozy Studio/Library
#   Linux:   ~/.local/share/cozy-studio/Library
#
# Override with an absolute path only when you want a custom location.
# Existing STUDIO_LIBRARY_DIR values are kept. Cozy Studio does not auto-migrate
# an older library folder.
# STUDIO_LIBRARY_DIR=/Users/<your-user>/Cozy Studio Library
#
# Default folder for generated images on a new library. Leave unset for
# the system Pictures folder/Cozy Studio (Windows Known Folder, macOS ~/Pictures,
# Linux XDG_PICTURES_DIR). Onboarding and Settings, Files & naming can change it later.
# STUDIO_IMAGES_DIR=/Users/<your-user>/Pictures/Cozy Studio

# HTTP port for the local backend.
STUDIO_SERVER_PORT=17223

# WebSocket port used by codex app-server.
STUDIO_CODEX_WS_PORT=17224

# Optional UI override for the local backend base URL used by Vite.
VITE_STUDIO_API_BASE=http://127.0.0.1:17223

# Worker resource limits. Restart the server after edits. Global: 1-16;
# each provider: 1-global. Invalid settings stop startup.
STUDIO_MAX_CONCURRENT_JOBS=4
STUDIO_MAX_CONCURRENT_CODEX_JOBS=1
STUDIO_MAX_CONCURRENT_GROK_JOBS=1
STUDIO_MAX_CONCURRENT_GOOGLE_JOBS=1
STUDIO_MAX_CONCURRENT_ANTIGRAVITY_JOBS=1
STUDIO_MAX_CONCURRENT_FAL_JOBS=1
STUDIO_MAX_CONCURRENT_COMFY_JOBS=1
STUDIO_MAX_CONCURRENT_DRY_RUN_JOBS=1

# Default model and reasoning effort for imagegen turns in codex app-server.
# Optional Codex paths, absolute for the current OS. Leave unset for discovery.
# STUDIO_CODEX_CLI_PATH=/absolute/path/to/codex
# CODEX_HOME=/absolute/path/to/codex-profile
CODEX_IMAGEGEN_MODEL=gpt-5.4-mini
CODEX_IMAGEGEN_REASONING_EFFORT=low

# Optional Grok Imagine runtime overrides. Studio can use authenticated xAI HTTP
# or the signed-in Grok Build CLI under its fallback policy. Leave model overrides
# unset to use the current provider defaults; inspect providers:preflight first.
# STUDIO_GROK_CLI_PATH=C:\Users\<your-user>\.grok\bin\grok.exe
# GROK_HOME=C:\Users\<your-user>\.grok
# GROK_IMAGE_MODEL=grok-imagine-image-2.0
# STUDIO_GROK_TIMEOUT_MS=900000

# Optional direct Google Nano Banana access. Use a restricted Gemini API key,
# or configure the desktop OAuth fields below and connect Google in Settings.
# API keys take priority when both paths are ready.
# GOOGLE_API_KEY=
# GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# Optional Google desktop OAuth. Enable the Generative Language API, create a
# Desktop app OAuth client, and use the Cloud project that owns billing/quota.
# The client secret is optional for clients that do not require it.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLOUD_PROJECT_ID=

# Optional Antigravity CLI provider. Authenticate once in an interactive `agy`
# session. The model is an `agy models` reasoning model; generate_image remains
# an internal tool. Use an absolute executable path when overriding discovery.
# STUDIO_ANTIGRAVITY_CLI_PATH=C:\Users\<your-user>\AppData\Local\agy\bin\agy.exe
# ANTIGRAVITY_IMAGE_MODEL=gemini-3.8-flash-low
# STUDIO_ANTIGRAVITY_TIMEOUT_MS=900000

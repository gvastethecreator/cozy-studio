{
  "name": "codex-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first studio to generate and manage images through ChatGPT HTTP, Codex app-server, and other providers.",
  "keywords": [
    "bun",
    "chatgpt",
    "codex",
    "hono",
    "image-generation",
    "local-first",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:ui": "vp dev",
    "dev:server": "bun apps/local-server/src/index.ts",
    "dev:electron": "bun run scripts/dev-electron.ts",
    "studio:init": "bun run scripts/studio-init.ts",
    "studio:onboard": "bun run scripts/studio-onboard.ts",
    "assets:migrate:webp": "bun run scripts/migrate-image-assets-to-webp.ts",
    "assets:responsive": "bun run scripts/build-responsive-ui-images.ts",
    "assets:responsive:check": "bun run scripts/build-responsive-ui-images.ts --check",
    "assets:character-lab:icons": "bun run scripts/build-character-lab-icon-assets.ts",
    "assets:character-lab:option-icons": "bun run scripts/build-character-lab-option-icon-assets.ts",
    "styles:scaffold": "bun run scripts/scaffold-style-preset.ts",
    "styles:validate": "bun run scripts/validate-style-preset-manifests.ts",
    "styles:taxonomy": "bun run scripts/backfill-style-preset-taxonomy.ts",
    "styles:catalog": "bun run scripts/query-style-preset-catalog.ts",
    "styles:runtime": "bun run styles:curation:policies && bun run scripts/generate-style-runtime-data.ts",
    "styles:runtime:check": "bun run scripts/generate-style-curation-policies.ts --check && bun run scripts/generate-style-runtime-data.ts --check",
    "styles:thumbnails": "bun run scripts/generate-style-thumbnail-projections.ts",
    "styles:thumbnails:check": "bun run scripts/generate-style-thumbnail-projections.ts --check",
    "styles:templates:verify": "bun run scripts/validate-style-preset-templates.ts",
    "styles:source:verify": "bun run scripts/style-authoring-source-audit.ts",
    "styles:quality:audit": "bun run scripts/audit-style-preset-quality.ts",
    "styles:scene-lock:audit": "bun run scripts/audit-style-preset-scene-lock.ts",
    "styles:dna:audit": "bun run scripts/audit-style-preset-dna-completeness.ts",
    "styles:defaults": "bun run scripts/generate-style-defaults.ts",
    "styles:defaults:grok": "bun run scripts/generate-style-defaults.ts --provider=grok",
    "styles:provider-variants:verify": "bun run scripts/validate-style-provider-variants.ts",
    "styles:thumbs": "bun run scripts/build-style-pack-card-thumbnails.ts",
    "styles:verify": "bun run styles:validate -- --coverage --strict-taxonomy && bun run styles:provider-variants:verify -- --provider=grok && bun run styles:runtime:check && bun run styles:thumbnails:check && bun run styles:templates:verify && bun run styles:source:verify && bun run styles:render:verify && bun run styles:curation:verify",
    "styles:browser": "tsx ./scripts/verify-styles-browser-gate.ts",
    "styles:browser:verify": "tsx ./scripts/verify-styles-browser-gate.ts --verify",
    "recipes:catalog": "bun run scripts/query-recipe-modules.ts",
    "recipes:examples:verify": "bun run scripts/validate-recipe-module-examples.ts",
    "recipes:source:verify": "bun run scripts/recipe-module-source-audit.ts",
    "recipes:verify": "bun run scripts/query-recipe-modules.ts --verify && bun run recipes:examples:verify && bun run recipes:source:verify && bun run recipes:evaluate -- --verify",
    "recipes:evaluate": "bun run scripts/evaluate-recipe-prompts.ts",
    "recipes:evaluate:live": "bun run scripts/evaluate-recipe-prompts-live.ts",
    "providers:audit": "bun run scripts/audit-provider-inputs.ts",
    "providers:source:verify": "bun run scripts/provider-boundary-source-audit.ts",
    "providers:verify": "bun run providers:audit -- --verify && bun run providers:source:verify",
    "providers:preflight": "bun run scripts/query-provider-runtime.ts",
    "runtime:doctor": "bun run scripts/query-codex-runtime.ts",
    "portability:smoke": "bun run scripts/portability-smoke.ts",
    "catalog:source:verify": "bun run scripts/catalog-first-source-audit.ts",
    "workspace:source:verify": "bun run scripts/workspace-authority-source-audit.ts",
    "isolation:verify": "bunx vitest run contexts/GenerationIsolation.runtime.test.tsx contexts/RuntimeLogIsolation.runtime.test.tsx contexts/RuntimeLogContext.subscription.test.ts hooks/useStudioShell.composition.test.ts hooks/useGenerationQueueController.test.tsx hooks/useCatalogModalDetailHydration.test.tsx hooks/useStudioReset.test.ts",
    "library:layout:verify": "bun run scripts/studio-library-layout-source-audit.ts",
    "storage:audit": "bun run scripts/studio-storage-maintenance.ts audit",
    "storage:compact": "bun run scripts/studio-storage-maintenance.ts compact",
    "storage:thumbnails:backfill": "bun run scripts/studio-storage-maintenance.ts thumbnails:backfill",
    "ui:chunks": "bun run scripts/report-ui-chunks.ts",
    "ui:chunks:verify": "bun run scripts/report-ui-chunks.ts --verify",
    "ui:source:verify": "bun run scripts/ui-demand-surface-audit.ts",
    "architecture:verify": "bun run styles:source:verify && bun run recipes:source:verify && bun run providers:source:verify && bun run catalog:source:verify && bun run library:layout:verify && bun run ui:source:verify && bun run workspace:source:verify && bun run isolation:verify",
    "ui:responsive": "tsx ./scripts/verify-responsive-mobile.ts",
    "ui:responsive:verify": "tsx ./scripts/verify-responsive-mobile.ts --verify",
    "styles:render": "bun run scripts/report-style-render-budget.ts",
    "styles:render:verify": "bun run scripts/report-style-render-budget.ts --verify",
    "fmt": "bun run scripts/tooling-task.ts fmt",
    "fmt:check": "bun run scripts/tooling-task.ts fmt:check",
    "lint": "bun run scripts/tooling-task.ts lint",
    "lint:fix": "bun run scripts/tooling-task.ts lint:fix",
    "check": "bun run scripts/tooling-task.ts check",
    "check:fix": "bun run scripts/tooling-task.ts check:fix",
    "typecheck:web": "bunx tsc --noEmit --pretty false -p tsconfig.web.json",
    "typecheck:shared": "bunx tsc --noEmit --pretty false -p packages/shared/tsconfig.json",
    "typecheck:scripts": "bunx tsc --noEmit --pretty false -p tsconfig.scripts.json && bunx tsc --noEmit --pretty false -p tsconfig.browser-scripts.json",
    "typecheck:environments": "bun run typecheck:web && bun run build:server && bun run typecheck:shared && bun run typecheck:scripts",
    "test": "bun run scripts/tooling-task.ts test",
    "test:unit": "bun run scripts/tooling-task.ts test:unit",
    "test:coverage": "bun run scripts/tooling-task.ts test:coverage",
    "build": "bun run scripts/tooling-task.ts build",
    "build:ui": "bun run scripts/tooling-task.ts build:ui",
    "build:server": "bun run scripts/tooling-task.ts build:server",
    "validate:fast": "bun run scripts/tooling-task.ts validate:fast",
    "validate": "bun run scripts/tooling-task.ts validate",
    "validate:full": "bun run scripts/tooling-task.ts validate:full",
    "validate:release": "bun run scripts/tooling-task.ts validate:release",
    "docs:check": "bun run scripts/check-docs.ts",
    "repo:hygiene:verify": "bun run scripts/audit-repo-hygiene.ts --verify",
    "repo:assets:audit": "bun run scripts/audit-repo-assets.ts --verify",
    "repo:assets:lock": "bun run scripts/audit-repo-assets.ts --update-lock",
    "core-assets:smoke": "bun run scripts/core-assets-smoke.ts",
    "handoff:export": "bun run scripts/interface-handoff/export.ts",
    "preview": "vp preview",
    "preview:electron": "bun run scripts/preview-electron.ts",
    "tooling:logs": "bun run scripts/open-tooling-logs.ts",
    "tooling:logs:prune": "bun run scripts/tooling-task.ts tooling:logs:prune",
    "doctor": "bunx react-doctor@0.9.13",
    "styles:curation:audit": "bun run scripts/audit-style-curation.ts",
    "styles:curation:verify": "bun run scripts/audit-style-curation.ts --verify",
    "styles:curation:policies": "bun run scripts/generate-style-curation-policies.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@fal-ai/client": "^1.10.1",
    "@gsap/react": "^2.1.2",
    "@tabler/icons-react": "^3.48.0",
    "clsx": "^2.1.1",
    "effect": "^3.22.2",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "hono": "^4.13.9",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "jsdom": "^30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "nanoid": "3.3.19",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postcss": "8.5.28",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.2"
}
